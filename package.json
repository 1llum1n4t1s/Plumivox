{
  "name": "plumivox",
  "version": "1.0.6",
  "private": true,
  "description": "TwitterAPI.ioを使うX投稿・フォロー先フィードのローカルMCPサーバー",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "bin": {
    "plumivox": "./dist/plumivox.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/plumivox.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:proxy-e2e": "node scripts/test-proxy.mjs",
    "test:proxy-shared-e2e": "node scripts/test-proxy.mjs",
    "test:setup-e2e": "node tests/setup-e2e.mjs && node tests/setup-vps-e2e.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "emoji-regex": "11.0.0",
    "ssh2": "1.17.0",
    "twitter-text": "3.1.0",
    "zod": "4.6.7"
  }
}
